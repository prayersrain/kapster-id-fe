{
  "name": "kapster-landing-ui",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:landing": "next dev --hostname 127.0.0.1",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "npm run build:api && node apps/api/dist/main.js",
    "build": "npm run build:api && npm run build:web && next build",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:web": "tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit && tsc -p apps/web/tsconfig.json && tsc -p apps/api/tsconfig.json --noEmit",
    "test": "npm run build:api && node --test tests/api.test.mjs",
    "test:browser": "npm run build:api && playwright test",
    "local:accounts": "node scripts/local-info.mjs accounts",
    "local:mail": "node scripts/local-info.mjs mail"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "next": "^16.3.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.18.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "overrides": {
    "multer": "^2.3.0"
  }
}
